{
    "CS2ServerGuidelines": "https://blog.counter-strike.net/index.php/server_guidelines/",
    "CommandPrefixes": [
        "!"
    ],
    "CommandSilentPrefixes": [
        "/"
    ],
    "AutoHotReload": true,
    "ProfilerLevel": 0,
    "ConsoleFilter": true,
    "ConsoleLogger": {
        "Enable": true,
        "ManagedEnable": true,
        "WriteIntervalMs": 2000,
        "Rotation": {
            "Enable": true,
            "Mode": "file_count",
            "AvailableModes": [
                "file_count",
                "time_interval"
            ],
            "MaximumFiles": 60,
            "DeleteOlderThanHours": 168
        }
    },
    "FollowCS2ServerGuidelines": true,
    "Language": "en",
    "ManualLoadPlugins": false,
    "PluginLoadOrder": [],
    "DotnetCrashTracerLevel": 0,
    "WindowsFullDump": false,
    "Menu": {
        "AvailableInputModes": [
            "button",
            "wasd"
        ],
        "Buttons": {
            "Exit": "tab",
            "Scroll": "shift",
            "ScrollBack": "f",
            "Use": "e"
        },
        "InputMode": "button",
        "NavigationPrefix": "➤",
        "Sound": {
            "Exit": {
                "Name": "Vote.Failed",
                "Volume": 0.75
            },
            "Scroll": {
                "Name": "UI.ContractType",
                "Volume": 0.75
            },
            "Use": {
                "Name": "Vote.Cast.Yes",
                "Volume": 0.75
            }
        },
        "ItemsPerPage": 5
    },
    "PatchesToPerform": [],
    "SteamAuth": {
        "AvailableModes": [
            "flexible",
            "strict"
        ],
        "Mode": "flexible"
    },
    "Unlocker": {
        "Convars": false,
        "ConCommands": false
    },
    "UsePlayerLanguage": true
}
