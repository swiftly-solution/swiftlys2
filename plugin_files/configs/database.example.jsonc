{
    // Default connection name
    "default_connection": "default",
    // Connections can be defined in two formats:
    // 1. URI format: "driver://user:password@host:port/database"
    // 2. Object format: { "driver": "...", "host": "...", ... }
    "connections": {
        // URI format examples
        "default": "mysql://root:@localhost:3306/swiftlys2",
        "postgres_uri": "postgresql://postgres:@localhost:5432/swiftlys2",
        "local": "sqlite://swiftlys2-local.db",
        // Object format example
        // "options" takes the connection string keywords of the driver (MySqlConnector, Npgsql and System.Data.SQLite),
        // values can be strings, numbers or booleans. They are applied after the other fields, so they can override them.
        // A keyword or a value that the driver doesn't know is an error when the connection is requested.
        "mysql_detailed": {
            "driver": "mysql",
            "host": "localhost",
            "database": "swiftlys2",
            "user": "root",
            "pass": "",
            "port": 3306,
            "timeout": 30,
            "options": {
                "SslMode": "Preferred",
                "CharacterSet": "utf8mb4",
                "MaximumPoolSize": 50,
                "DefaultCommandTimeout": 60
            }
        },
        "postgres_detailed": {
            "driver": "postgresql",
            "host": "localhost",
            "database": "swiftlys2",
            "user": "postgres",
            "pass": "",
            "port": 5432,
            "timeout": 30,
            "options": {
                "SSL Mode": "Prefer",
                "Maximum Pool Size": 50,
                "Command Timeout": 60,
                "Search Path": "public"
            }
        },
        "sqlite_detailed": {
            "driver": "sqlite",
            "database": "data/swiftlys2-detailed.db",
            "options": {
                "Journal Mode": "Wal",
                "Foreign Keys": true,
                "Cache Size": 4000,
                "Default Timeout": 30
            }
        }
    }
}