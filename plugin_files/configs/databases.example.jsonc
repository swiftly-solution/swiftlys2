{
    // Supported drivers: "mysql", "postgresql", "sqlite"
    // Default driver used when connection specifies "driver": "default"
    "driver_default": "mysql",
    // MySQL connection example
    "default": {
        "driver": "default",
        "host": "localhost",
        "database": "swiftly",
        "user": "root",
        "pass": "",
        "timeout": 30,
        "port": 3306
    },
    // PostgreSQL connection example
    "postgres": {
        "driver": "postgresql",
        "host": "localhost",
        "database": "swiftly",
        "user": "postgres",
        "pass": "",
        "timeout": 30,
        "port": 5432
    },
    // SQLite connection example (only database path is required)
    "local": {
        "driver": "sqlite",
        "database": "swiftly-local.db"
    }
}