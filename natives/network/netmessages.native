class NetMessages

ptr AllocateNetMessageByID = int32 msgid
ptr AllocateNetMessageByPartialName = string name
void DeallocateNetMessage = ptr netmsg
bool HasField = ptr netmsg, string fieldName
bool GetValue = ptr netmsg, string fieldName, int32 index, int32 kind, ptr value
bool SetValue = ptr netmsg, string fieldName, int32 index, int32 kind, ptr value
bool AddValue = ptr netmsg, string fieldName, int32 kind, ptr value
string GetString = ptr netmsg, string fieldName, int32 index
void SetString = ptr netmsg, string fieldName, int32 index, string value
void AddString = ptr netmsg, string fieldName, string value
bytes GetBytes = ptr netmsg, string fieldName, int32 index
void SetBytes = ptr netmsg, string fieldName, int32 index, bytes value
void AddBytes = ptr netmsg, string fieldName, bytes value
ptr GetNestedMessage = ptr netmsg, string fieldName
ptr GetRepeatedNestedMessage = ptr netmsg, string fieldName, int32 index
ptr AddNestedMessage = ptr netmsg, string fieldName
int32 GetRepeatedFieldSize = ptr netmsg, string fieldName
void ClearRepeatedField = ptr netmsg, string fieldName
void Clear = ptr netmsg
sync void SendMessage = ptr netmsg, int32 msgid, int32 playerid
sync void SendMessageToPlayers = ptr netmsg, int32 msgid, uint64 playermask // each bit in player_mask represents a playerid
void RegisterMessageHook = int32 hookType, int32 messageid // hookType: 0 = server, 1 = client, 2 = server internal, only registered messages are sent to the hooks
void UnregisterMessageHook = int32 hookType, int32 messageid
void SetNetMessageServerHook = ptr callback // the callback should receive the following: uint64* playermask_ptr, int netmessage_id, void* netmsg, return HookResult int
void SetNetMessageClientHook = ptr callback // the callback should receive the following: int32 playerid, int netmessage_id, void* netmsg, return HookResult int
void SetNetMessageServerHookInternal = ptr callback // callback should receive the following: int32 playerid, int netmessage_id, void* netmsg, return HookResult int