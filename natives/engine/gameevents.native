class GameEvents

bool GetValue = ptr _event, string key, int32 kind, ptr value
bool SetValue = ptr _event, string key, int32 kind, ptr value
string GetString = ptr _event, string key
void SetString = ptr _event, string key, string value
bool HasKey = ptr _event, string key
bool IsReliable = ptr _event
bool IsLocal = ptr _event
void RegisterListener = string eventName
void UnregisterListener = string eventName
void SetListenerPreHandler = ptr callback // the callback should receive the following: uint32 eventNameHash, IntPtr gameEvent, bool* dontBroadcast, return HookResult int
void SetListenerPostHandler = ptr callback // the callback should receive the following: uint32 eventNameHash, IntPtr gameEvent, bool* dontBroadcast, return HookResult int
ptr CreateEvent = string eventName
void FreeEvent = ptr _event
sync void FireEvent = ptr _event, bool dontBroadcast
sync void FireEventToClient = ptr _event, int32 playerid
bool IsPlayerListeningToEventName = int32 playerid, string eventName
bool IsPlayerListeningToEvent = int32 playerid, ptr _event